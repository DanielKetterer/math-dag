{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "math-dag node",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "concept", "facet", "level", "type", "name", "statement", "assess", "requires", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"},
    "concept": {"type": "string"},
    "facet": {"type": "string"},
    "level": {"type": "integer", "minimum": 1, "maximum": 4},
    "type": {"enum": ["concept", "procedure", "representation", "fact", "justification", "application"]},
    "name": {"type": "string", "minLength": 3},
    "statement": {"type": "string", "minLength": 10},
    "procedure": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "assess": {"type": "string", "minLength": 10},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ccss": {"type": "array", "items": {"type": "string"}},
        "learning_components": {"type": "array", "items": {"type": "string"}},
        "eedi": {"type": "array", "items": {"type": "string"}},
        "im360": {"type": "array", "items": {"type": "string"}},
        "other": {"type": "array", "items": {"type": "string"}},
        "prek": {"type": "array", "items": {"type": "string"}}
      }
    },
    "misconceptions": {"type": "array", "items": {"type": "string"}},
    "root_reason": {"type": "string", "minLength": 10},
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause", "all_of"],
        "properties": {
          "clause": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "note": {"type": "string"},
          "procedure": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "all_of": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node", "relation", "points_to", "why", "evidence"],
              "properties": {
                "node": {"type": "string"},
                "relation": {"enum": ["definitional", "procedural", "representational", "justificatory"]},
                "scope": {"enum": ["concept", "task"], "default": "concept"},
                "points_to": {"type": "string", "pattern": "^(statement|assess|procedure\\.[0-9]+)$"},
                "why": {"type": "string"},
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "source"],
                    "properties": {
                      "kind": {"enum": ["content", "standards", "curriculum", "developmental", "review"]},
                      "source": {"type": "string"},
                      "note": {"type": "string"}
                    }
                  }
                },
                "status": {"enum": ["proposed", "reviewed", "disputed"], "default": "proposed"}
              }
            }
          }
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "relation"],
        "properties": {
          "node": {"type": "string"},
          "relation": {"enum": ["generalizes", "specializes", "same_idea_different_form", "contrasts_with", "common_path"]},
          "note": {"type": "string"}
        }
      }
    },
    "status": {"enum": ["proposed", "reviewed", "disputed"]},
    "review_notes": {"type": "string"}
  }
}
